@page "/apps/{ApplicationId:guid}"
@implements IDisposable
@inject RouteService RouteService
@inject ApplicationService AppService
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_notFound)
{
    <PageTitle>Aplicação não encontrada</PageTitle>
    <h1>Aplicação não encontrada</h1>
    <div class="empty">
        Esta aplicação não existe ou pertence a outro usuário. <a href="">Voltar para minhas aplicações</a>
    </div>
}
else if (_application is not null)
{
    <PageTitle>@_application.Name · Gerenciador de Rotas</PageTitle>

    <div class="page-header">
        <a class="back-link" href="">← Aplicações</a>
        <h1>@_application.Name</h1>
        <p class="muted">
            Rotas em <code class="pattern">@BaseUrl/@_application.Slug/...</code>
            @if (!string.IsNullOrWhiteSpace(_application.Description))
            {
                <span> · @_application.Description</span>
            }
        </p>
    </div>

    <div class="grid">
        <section class="card form-card">
            <header class="card-header">
                <h2>Nova Rota</h2>
                <p class="muted">Crie uma rota simulada preenchendo os campos abaixo.</p>
            </header>

            <div class="form">
                <div class="form-row">
                    <label>Descrição <span class="optional">(opcional)</span></label>
                    <input class="input" @bind="_form.Description" placeholder="Descreva o propósito desta rota" />
                </div>

                <div class="form-row">
                    <label>Método HTTP</label>
                    <select class="input" @bind="_form.HttpMethod">
                        @foreach (var m in _methods)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <div class="label-row">
                        <label>Pattern (URL)</label>
                        <span class="help" tabindex="0">?
                            <span class="tooltip" role="tooltip">
                                <strong>Wildcards no path</strong>
                                <ul>
                                    <li><code>*</code> — qualquer valor em um segmento. Ex.: <code>/v*/heroes</code> casa <code>/v1/heroes</code>, <code>/v6/heroes</code>.</li>
                                    <li><code>{uuid}</code> ou <code>{guid}</code> — UUID/GUID</li>
                                    <li><code>{int}</code> — número inteiro</li>
                                    <li><code>{date}</code> — data <code>YYYY-MM-DD</code></li>
                                    <li><code>{datetime}</code> — data/hora ISO 8601</li>
                                    <li><code>{nome}</code> — qualquer segmento não vazio (qualquer nome dentro das chaves que não seja um tipo conhecido)</li>
                                    <li><code>{tipo?}</code> — sufixo <code>?</code> torna o segmento opcional. Ex.: <code>/v1/heroes/{uuid?}</code> casa tanto <code>/v1/heroes</code> quanto <code>/v1/heroes/3fa85f64-...</code></li>
                                </ul>
                                <strong>Query string</strong>
                                <p>Use <code>[tipo]</code> nos parâmetros de query. Ex.: <code>/v1/movies?year=[int]&id=[guid]</code></p>
                            </span>
                        </span>
                    </div>
                    <input class="input" @bind="_form.Pattern" placeholder="/v*/heroes/{uuid}" @ref="_patternInput" />
                </div>

                <div class="form-row two-cols">
                    <div>
                        <label>Status Code</label>
                        <input class="input" type="number" min="100" max="599" list="status-codes" @bind="_form.StatusCode" />
                        <datalist id="status-codes">
                            @foreach (var sc in _statusCodes)
                            {
                                <option value="@sc.Code">@sc.Code - @sc.Label</option>
                            }
                        </datalist>
                    </div>
                    <div>
                        <label>Processing time (ms)</label>
                        <input class="input" type="number" min="0" @bind="_form.ProcessingTime" />
                    </div>
                </div>

                <div class="form-row">
                    <label>Content-Type</label>
                    <select class="input" @bind="_form.ContentType">
                        @foreach (var ct in _contentTypes)
                        {
                            <option value="@ct.Value">@ct.Label</option>
                        }
                    </select>
                </div>

                <div class="form-row grow">
                    <div class="label-row">
                        <label>Response body</label>
                        <span class="help" tabindex="0">?
                            <span class="tooltip" role="tooltip">
                                <strong>Variáveis no response</strong>
                                <ul>
                                    <li><code>{{uuid}}</code> — UUID aleatório gerado a cada requisição</li>
                                    <li><code>{{$.nome}}</code> — valor da propriedade <code>nome</code> do request body (JSON)</li>
                                    <li><code>{{$.user.address.city}}</code> — suporta caminhos aninhados</li>
                                    <li><code>{{$.items[0]}}</code> — suporta acesso a arrays</li>
                                </ul>
                                <strong>Exemplo</strong>
                                <pre><code>&#123;
      "id": "&#123;&#123;uuid&#125;&#125;",
      "name": "&#123;&#123;$.name&#125;&#125;"
    &#125;</code></pre>
                                <p>Se a propriedade não existir no body, é substituída por string vazia.</p>
                            </span>
                        </span>
                    </div>
                    <textarea class="input mono" @bind="_form.ResponseBody"
                              placeholder='{ "message": "hello world" }'></textarea>
                </div>

                <div class="form-actions">
                    @if (_editingId.HasValue)
                    {
                        <button class="btn btn-primary" @onclick="HandleUpdate">Salvar alterações</button>
                        <button class="btn btn-ghost" @onclick="FormatResponseBody" title="Formatar o JSON do response body">{ } Formatar</button>
                        <button class="btn btn-ghost" @onclick="ResetForm">Cancelar</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="HandleCreate">Criar rota</button>
                        <button class="btn btn-ghost" @onclick="FormatResponseBody" title="Formatar o JSON do response body">{ } Formatar</button>
                        <button class="btn btn-ghost" @onclick="ResetForm">Limpar</button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-error">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_info))
                {
                    <div class="alert alert-ok">@_info</div>
                }
            </div>
        </section>

        <section class="card list-card">
            <header class="card-header row">
                <h2>Rotas <span class="counter">@_routes.Count</span></h2>
                <div class="header-actions">
                    <button class="btn btn-ghost" @onclick="ExportOpenApi" disabled="@(_routes.Count == 0)" title="Exportar como OpenAPI YAML">Exportar YAML</button>
                    <button class="btn btn-ghost" @onclick="Refresh">Atualizar</button>
                </div>
            </header>
            @if (_editingId.HasValue)
            {
                <div class="alert alert-ok">Editando rota — faça as alterações no formulário ao lado.</div>
            }

            @if (_routes.Count == 0)
            {
                <div class="empty">
                    Nenhuma rota cadastrada ainda. Crie a primeira no formulário ao lado.
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Método</th>
                                <th>Pattern</th>
                                <th>Status</th>
                                <th>Content-Type</th>
                                <th class="delay-col">Delay</th>
                                <th class="actions-col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var route in _routes)
                            {
                                <tr class="@(route.Enabled ? "" : "disabled")">
                                    <td><span class="method @MethodClass(route.HttpMethod)">@route.HttpMethod</span></td>
                                    <td>
                                        <code class="pattern">@route.Pattern</code>
                                        @if (!route.Enabled)
                                        {
                                            <span class="badge-off">desativada</span>
                                        }
                                    </td>
                                    <td><span class="status @StatusClass(route.StatusCode)">@route.StatusCode</span></td>
                                    <td class="muted">@route.ContentType</td>
                                    <td class="muted delay-col">@route.ProcessingTime ms</td>
                                    <td class="actions-col">
                                        <button class="btn-icon" title="Detalhes" @onclick="() => ToggleDetails(route.Id)">
                                            @(_expanded.Contains(route.Id) ? "▾" : "▸")
                                        </button>
                                        <button class="btn-icon @(_editingId == route.Id ? "active" : "")" title="Editar" @onclick="() => StartEdit(route.Id)">
                                            ✎
                                        </button>
                                        <button class="btn-icon @(route.Enabled ? "" : "active")"
                                                title="@(route.Enabled ? "Desativar (a rota passa a responder 404)" : "Ativar")"
                                                @onclick="() => ToggleEnabled(route)">
                                            @(route.Enabled ? "⏸" : "▶")
                                        </button>
                                        <button class="btn-icon btn-curl" title="Copiar curl" @onclick="() => CopyAsCurl(route)">
                                            &lt;&gt;
                                        </button>
                                        <button class="btn-icon danger" title="Excluir" @onclick="() => HandleDelete(route.Id)">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                                @if (_expanded.Contains(route.Id))
                                {
                                    <tr class="details">
                                        <td colspan="6">
                                            <div class="details-grid">
                                                <div><strong>ID</strong><code>@route.Id</code></div>
                                                @if (!string.IsNullOrWhiteSpace(route.Description))
                                                {
                                                    <div><strong>Descrição</strong><span>@route.Description</span></div>
                                                }
                                                <div class="details-body">
                                                    <strong>Response body</strong>
                                                    <pre class="mono">@(route.ResponseBody?.ToString() ?? "(vazio)")</pre>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}

@code {
    private readonly string[] _methods = new[] { "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS" };

    private readonly (int Code, string Label)[] _statusCodes = new (int, string)[]
    {
        (100, "Continue"),
        (101, "Switching Protocols"),
        (200, "OK"),
        (201, "Created"),
        (202, "Accepted"),
        (204, "No Content"),
        (206, "Partial Content"),
        (301, "Moved Permanently"),
        (302, "Found"),
        (304, "Not Modified"),
        (307, "Temporary Redirect"),
        (308, "Permanent Redirect"),
        (400, "Bad Request"),
        (401, "Unauthorized"),
        (403, "Forbidden"),
        (404, "Not Found"),
        (405, "Method Not Allowed"),
        (406, "Not Acceptable"),
        (408, "Request Timeout"),
        (409, "Conflict"),
        (410, "Gone"),
        (415, "Unsupported Media Type"),
        (422, "Unprocessable Entity"),
        (429, "Too Many Requests"),
        (500, "Internal Server Error"),
        (501, "Not Implemented"),
        (502, "Bad Gateway"),
        (503, "Service Unavailable"),
        (504, "Gateway Timeout"),
    };

    private readonly (string Value, string Label)[] _contentTypes = new (string, string)[]
    {
        ("application/json", "json"),
        ("application/xml", "xml"),
        ("text/plain", "texto"),
        ("text/html", "html"),
        ("text/csv", "csv"),
        ("text/javascript", "javascript"),
        ("text/css", "css"),
        ("application/pdf", "pdf"),
        ("application/octet-stream", "binário"),
        ("application/x-www-form-urlencoded", "form urlencoded"),
        ("multipart/form-data", "form data"),
        ("image/png", "imagem png"),
        ("image/jpeg", "imagem jpeg"),
        ("image/gif", "imagem gif"),
        ("image/svg+xml", "imagem svg"),
    };

    [Parameter]
    public Guid ApplicationId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private ApplicationModel? _application;
    private bool _notFound;
    private bool _focusPending;
    private FormModel _form = new();
    private List<RouteModel> _routes = new();
    private HashSet<Guid> _expanded = new();
    private string? _error;
    private string? _info;
    private Guid? _editingId;
    private CancellationTokenSource? _infoCts;
    private ElementReference _patternInput;

    private string BaseUrl => Nav.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        RouteService.OnChange += HandleChange;

        var state = await AuthState;
        var userId = state.User.GetUserId();
        _application = userId is null ? null : AppService.GetOwned(ApplicationId, userId.Value);
        _notFound = _application is null;

        if (_application is not null)
        {
            Refresh();
            _focusPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            await _patternInput.FocusAsync();
        }
    }

    public void Dispose()
    {
        RouteService.OnChange -= HandleChange;
        _infoCts?.Cancel();
        _infoCts?.Dispose();
    }

    private void HandleChange(Guid applicationId)
    {
        if (applicationId != _application?.Id) return;

        InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        if (_application is null) return;
        _routes = RouteService.GetByApplication(_application.Id).ToList();
    }

    private void HandleCreate()
    {
        _error = null;
        _info = null;

        if (string.IsNullOrWhiteSpace(_form.Pattern))
        {
            _error = "O campo Pattern é obrigatório.";
            return;
        }

        if (_form.StatusCode < 100 || _form.StatusCode > 599)
        {
            _error = "Status Code deve estar entre 100 e 599.";
            return;
        }

        try
        {
            var model = new RouteModel
            {
                HttpMethod = _form.HttpMethod,
                Pattern = NormalizePattern(_form.Pattern),
                StatusCode = _form.StatusCode,
                ProcessingTime = _form.ProcessingTime,
                ContentType = string.IsNullOrWhiteSpace(_form.ContentType) ? "application/json" : _form.ContentType.Trim(),
                ResponseBody = string.IsNullOrEmpty(_form.ResponseBody) ? null : _form.ResponseBody,
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
            };

            RouteService.Add(_application!.Id, model);
            SetInfo($"Rota criada: {model.HttpMethod} {model.Pattern}");
            ResetForm();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task HandleDelete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Excluir esta rota?");
        if (!confirmed) return;

        _error = null;
        try
        {
            RouteService.Remove(_application!.Id, id);
            _expanded.Remove(id);
            SetInfo("Rota removida.");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ToggleEnabled(RouteModel route)
    {
        _error = null;
        try
        {
            var enable = !route.Enabled;
            RouteService.SetEnabled(_application!.Id, route.Id, enable);
            SetInfo($"Rota {(enable ? "ativada" : "desativada")}: {route.HttpMethod} {route.Pattern}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ToggleDetails(Guid id)
    {
        if (!_expanded.Add(id))
        {
            _expanded.Remove(id);
        }
    }

    private void StartEdit(Guid id)
    {
        var route = _routes.FirstOrDefault(m => m.Id == id);
        if (route is null) return;

        _editingId = id;
        _error = null;
        _info = null;
        _form = new FormModel
        {
            HttpMethod = route.HttpMethod,
            Pattern = route.Pattern,
            StatusCode = route.StatusCode,
            ProcessingTime = route.ProcessingTime,
            ContentType = route.ContentType,
            ResponseBody = route.ResponseBody?.ToString() ?? string.Empty,
            Description = route.Description ?? string.Empty,
        };
    }

    private void HandleUpdate()
    {
        _error = null;
        _info = null;

        if (string.IsNullOrWhiteSpace(_form.Pattern))
        {
            _error = "O campo Pattern é obrigatório.";
            return;
        }

        if (_form.StatusCode < 100 || _form.StatusCode > 599)
        {
            _error = "Status Code deve estar entre 100 e 599.";
            return;
        }

        try
        {
            var updated = new RouteModel
            {
                HttpMethod = _form.HttpMethod,
                Pattern = NormalizePattern(_form.Pattern),
                StatusCode = _form.StatusCode,
                ProcessingTime = _form.ProcessingTime,
                ContentType = string.IsNullOrWhiteSpace(_form.ContentType) ? "application/json" : _form.ContentType.Trim(),
                ResponseBody = string.IsNullOrEmpty(_form.ResponseBody) ? null : _form.ResponseBody,
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
            };

            RouteService.Update(_application!.Id, _editingId!.Value, updated);
            SetInfo($"Rota atualizada: {updated.HttpMethod} {updated.Pattern}");
            ResetForm();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ResetForm()
    {
        _form = new FormModel();
        _editingId = null;
    }

    private static string NormalizePattern(string pattern)
    {
        var p = pattern.Trim();
        return p.StartsWith('/') ? p : "/" + p;
    }

    private async Task ExportOpenApi()
    {
        var yaml = OpenApiExporter.ExportYaml(_routes, _application!.Name, $"{BaseUrl}/{_application.Slug}");
        await JS.InvokeVoidAsync("downloadFile", $"{_application.Slug}.openapi.yaml", yaml, "application/x-yaml");
    }

    private async Task CopyAsCurl(RouteModel route)
    {
        var curl = new System.Text.StringBuilder($"curl -X {route.HttpMethod} \"{BaseUrl}/{_application!.Slug}{route.Pattern}\"");

        if (route.HttpMethod is "POST" or "PUT" or "PATCH")
        {
            curl.Append($" -H \"Content-Type: {route.ContentType}\"");
            curl.Append(" -d ''");
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", curl.ToString());
        SetInfo("curl copiado para a área de transferência.");
    }

    private void SetInfo(string message)
    {
        _infoCts?.Cancel();
        _infoCts?.Dispose();
        _infoCts = new CancellationTokenSource();
        _info = message;
        _ = ClearInfoAfterDelayAsync(_infoCts.Token);
    }

    private async Task ClearInfoAfterDelayAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(5000, ct);
            _info = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void FormatResponseBody()
    {
        if (string.IsNullOrWhiteSpace(_form.ResponseBody)) return;
        try
        {
            var obj = JsonConvert.DeserializeObject(_form.ResponseBody);
            _form.ResponseBody = JsonConvert.SerializeObject(obj, Formatting.Indented);
        }
        catch { }
    }

    private static string MethodClass(string method) => method.ToUpperInvariant() switch
    {
        "GET" => "m-get",
        "POST" => "m-post",
        "PUT" => "m-put",
        "PATCH" => "m-patch",
        "DELETE" => "m-delete",
        _ => "m-other",
    };

    private static string StatusClass(int code) => code switch
    {
        >= 200 and < 300 => "s-ok",
        >= 300 and < 400 => "s-redir",
        >= 400 and < 500 => "s-cli",
        >= 500 => "s-srv",
        _ => "",
    };

    private class FormModel
    {
        public string HttpMethod { get; set; } = "GET";
        public string Pattern { get; set; } = string.Empty;
        public int StatusCode { get; set; } = 200;
        public int ProcessingTime { get; set; } = 0;
        public string ContentType { get; set; } = "application/json";
        public string ResponseBody { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
