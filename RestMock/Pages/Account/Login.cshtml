@page "/account/login"
@model RestMock.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="card auth-card">
    <header class="card-header">
        <h2>Entrar</h2>
        <p class="muted">Acesse suas aplicações mockadas.</p>
    </header>

    <form method="post" class="form">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="form-row">
            <label asp-for="UserName">Usuário</label>
            <input class="input" asp-for="UserName" autocomplete="username" autofocus required />
        </div>
        <div class="form-row">
            <label asp-for="Password">Senha</label>
            <input class="input" asp-for="Password" autocomplete="current-password" required />
        </div>

        @if (Model.Error is not null)
        {
            <div class="alert alert-error">@Model.Error</div>
        }

        <div class="form-actions">
            <button class="btn btn-primary btn-block" type="submit">Entrar</button>
        </div>
    </form>

    <partial name="_GitHubLogin" model="Model" />

    <p class="auth-footer muted">
        Não tem conta? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Criar conta</a>
    </p>
</section>
