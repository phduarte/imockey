@page "/account/register"
@model RestMock.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}

<section class="card auth-card">
    <header class="card-header">
        <h2>Criar conta</h2>
        <p class="muted">Cada usuário tem suas próprias aplicações e mocks, isolados dos demais.</p>
    </header>

    <form method="post" class="form">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="form-row">
            <label asp-for="UserName">Usuário</label>
            <input class="input" asp-for="UserName" autocomplete="username" autofocus required
                   minlength="3" maxlength="32" pattern="[A-Za-z0-9._\-]+" />
        </div>
        <div class="form-row">
            <label asp-for="DisplayName">Nome de exibição <span class="optional">(opcional)</span></label>
            <input class="input" asp-for="DisplayName" autocomplete="name" />
        </div>
        <div class="form-row">
            <label asp-for="Password">Senha</label>
            <input class="input" asp-for="Password" autocomplete="new-password" required
                   minlength="@RestMock.Services.UserService.MinPasswordLength" />
        </div>
        <div class="form-row">
            <label asp-for="ConfirmPassword">Confirmar senha</label>
            <input class="input" asp-for="ConfirmPassword" autocomplete="new-password" required />
        </div>

        @if (Model.Error is not null)
        {
            <div class="alert alert-error">@Model.Error</div>
        }

        <div class="form-actions">
            <button class="btn btn-primary btn-block" type="submit">Criar conta</button>
        </div>
    </form>

    <partial name="_GitHubLogin" model="Model" />

    <p class="auth-footer muted">
        Já tem conta? <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Entrar</a>
    </p>
</section>
