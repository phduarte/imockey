@model RestMock.Pages.Account.AccountPageModel

@if (Model.GitHubEnabled)
{
    <div class="auth-divider"><span>ou</span></div>
    <form method="post" asp-page-handler="GitHub">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <button class="btn btn-github btn-block" type="submit">Entrar com GitHub</button>
    </form>
}
