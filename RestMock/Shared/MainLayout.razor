@inherits LayoutComponentBase

<div class="app">
    <header class="topbar">
        <div class="brand">
            <span class="brand-mark">⚡</span>
            <span class="brand-title">RestMock</span>
            <span class="brand-sub">Mock Client</span>
        </div>
        <nav class="topnav">
            <NavLink class="navlink" href="/" Match="NavLinkMatch.All">Aplicações</NavLink>
        </nav>
        <AuthorizeView>
            <div class="user-menu">
                <span class="muted">@context.User.Identity?.Name</span>
                @* Plain form post: the auth cookie can only be cleared by an HTTP response, not by the Blazor circuit. *@
                <form method="post" action="/account/logout">
                    <button class="btn btn-ghost btn-sm" type="submit">Sair</button>
                </form>
            </div>
        </AuthorizeView>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">
        <small>RestMock · gerenciador de endpoints simulados</small>
    </footer>
</div>
